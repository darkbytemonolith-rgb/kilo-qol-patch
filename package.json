{
  "name": "kilo-qol-patch",
  "displayName": "Kilo QoL Patch",
  "description": "Quality-of-life patcher for the Kilo Code chat webview. Renders MCP tool-result images (read_image, browser screenshots) inline, one per row with its path, plus a status-bar indicator and auto-apply.",
  "version": "0.1.0",
  "publisher": "darkbyte",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkbytemonolith-rgb/kilo-qol-patch.git"
  },
  "bugs": {
    "url": "https://github.com/darkbytemonolith-rgb/kilo-qol-patch/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "kilo",
    "kilo code",
    "mcp",
    "patch",
    "images"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kiloQolPatch.apply",
        "title": "Kilo QoL Patch: Apply / Re-apply"
      },
      {
        "command": "kiloQolPatch.remove",
        "title": "Kilo QoL Patch: Remove (restore original)"
      },
      {
        "command": "kiloQolPatch.status",
        "title": "Kilo QoL Patch: Status"
      },
      {
        "command": "kiloQolPatch.menu",
        "title": "Kilo QoL Patch: Open Menu"
      }
    ],
    "configuration": {
      "title": "Kilo QoL Patch",
      "properties": {
        "kiloQolPatch.autoApply": {
          "type": "boolean",
          "default": true,
          "description": "Automatically apply the patch on startup and after a Kilo Code update replaces the webview. When off, you will be asked before applying."
        },
        "kiloQolPatch.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar indicator for the patch state."
        }
      }
    }
  }
}
